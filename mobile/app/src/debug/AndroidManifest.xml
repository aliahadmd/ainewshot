<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets `adb shell am broadcast` fire a real alert for testing. -->
        <receiver android:name=".DebugReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.aliahad.ainewshot.DEBUG_ALERT" />
                <action android:name="com.aliahad.ainewshot.DEBUG_PODCAST" />
                <action android:name="com.aliahad.ainewshot.DEBUG_PLAY" />
                <action android:name="com.aliahad.ainewshot.DEBUG_PAUSE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
